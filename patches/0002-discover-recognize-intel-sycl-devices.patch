 }
+
+// syclVisibleDeviceTokens extracts the Level Zero device ids from a
+// user-provided ONEAPI_DEVICE_SELECTOR such as "level_zero:0,2" or
+// "level_zero:1;opencl:*". Wildcards and other backends are ignored.
+func syclVisibleDeviceTokens(selector string) []string {
+	for _, term := range strings.Split(selector, ";") {
+		backend, ids, ok := strings.Cut(strings.TrimSpace(term), ":")
+		if !ok || !strings.EqualFold(strings.TrimSpace(backend), "level_zero") {
+			continue
+		}
+		if strings.TrimSpace(ids) == "*" {
+			return nil
+		}
+		return splitVisibleDeviceList(ids)
+	}
+	return nil
+}
diff --git a/discover/sycl_test.go b/discover/sycl_test.go
new file mode 100644
index 0000000..07b7323
--- /dev/null
+++ b/discover/sycl_test.go
@@ -0,0 +1,29 @@
+package discover
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestInferLibrarySYCL(t *testing.T) {
+	if got := inferLibrary("SYCL0", "Intel(R) Arc(TM) 140T GPU"); got != "SYCL" {
+		t.Fatalf("inferLibrary = %q, want SYCL", got)
+	}
+}
+
+func TestSYCLVisibleDeviceTokens(t *testing.T) {
+	for _, tc := range []struct {
+		in   string
+		want []string
+	}{
+		{"", nil},
+		{"level_zero:0", []string{"0"}},
+		{"level_zero:0,2", []string{"0", "2"}},
+		{"opencl:*;level_zero:1", []string{"1"}},
+		{"level_zero:*", nil},
+	} {
+		if got := syclVisibleDeviceTokens(tc.in); !slices.Equal(got, tc.want) {
+			t.Errorf("syclVisibleDeviceTokens(%q) = %v, want %v", tc.in, got, tc.want)
+		}
+	}
+}
